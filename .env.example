# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Claude (Anthropic): classifies and translates each utterance
ANTHROPIC_API_KEY=""
# ElevenLabs: realtime speech-to-text tokens and text-to-speech (needs Speech to Text + Text to Speech access)
ELEVENLABS_API_KEY=""

# OIDC sign-in (confidential client; callback /api/auth/callback/oidc, logout callback /login)
OIDC_DISCOVERY_URL="https://id.example.com/.well-known/openid-configuration"
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
